# ---------------------------------------------------------------------------
# Dolane Cleaning Services — environment variables
#
# Copy to .env.local for local development, and add the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# NEVER commit .env.local. NEVER put a server secret in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# The canonical production URL. Drives canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dolanecleaningservices.com

# The public business mailbox. Leave EMPTY until it actually exists — every
# email affordance on the site stays hidden while this is unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Quote form delivery ----------------------------------------------------
# REQUIRED BEFORE LAUNCH: configure at least one of the three channels below,
# or submitted quote requests will only be written to the server log.

# Email via Resend (https://resend.com)
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=
QUOTE_FROM_EMAIL=

# SMS via Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Defaults to the business number in lib/site.ts when left blank.
QUOTE_SMS_TO=

# Generic webhook (Zapier, Make, a CRM endpoint, …)
QUOTE_WEBHOOK_URL=

# --- Firebase (optional) ----------------------------------------------------
# Public web-app config only. These are safe to expose and are protected by
# Firebase Security Rules. Do NOT add a service account or private key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Social & reviews (optional) --------------------------------------------
# Each link is hidden until it is filled in.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
