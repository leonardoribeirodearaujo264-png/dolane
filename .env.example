# ---------------------------------------------------------------------------
# Dolane Cleaning Services — environment variables
#
# Copy to .env.local for local development, and add the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# NEVER commit .env.local. NEVER put a server secret in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# The canonical production URL. Drives canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dolanecleaningservices.com

# The public business mailbox SHOWN on the site. Leave EMPTY to keep the current
# design (no visible email). Does NOT affect lead notifications.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (lead storage) ------------------------------------------------
# The publishable key is safe to expose; writes are governed by RLS on `leads`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Lead email notification (Resend) ---------------------------------------
# On a new lead, a notification is emailed via Resend to LEADS_NOTIFICATION_EMAIL.
# Server-side only. Create a key at https://resend.com/api-keys. For delivery to
# any inbox, verify a domain (https://resend.com/domains) and set a sender on it
# in RESEND_FROM_EMAIL. Leave RESEND_API_KEY empty to disable email while still
# saving leads to Supabase.
RESEND_API_KEY=
# Verified sender, e.g. "Dolane Cleaning <leads@your-domain.com>". Blank = test sender.
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=

# --- Firebase (optional) ----------------------------------------------------
# Public web-app config only. These are safe to expose and are protected by
# Firebase Security Rules. Do NOT add a service account or private key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Analytics (optional) ---------------------------------------------------
# Meta (Facebook) Pixel ID. Public identifier; the component ships with a
# default, so set this only to override or to disable it (leave blank to use
# the built-in default).
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Social & reviews (optional) --------------------------------------------
# Each link is hidden until it is filled in.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
